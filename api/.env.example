# Copia este archivo a .env (NO lo subas al repositorio) o define estas variables en el hosting (Render).

# Puerto HTTP (Render lo fija solo)
PORT=8080

# Proyecto de Firebase
FIREBASE_PROJECT_ID=

# Clave de la cuenta de servicio (Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave
# privada). Pega el JSON completo en una sola línea, o su base64. Es un SECRETO del servidor: nunca en el repositorio ni
# en la app móvil.
FIREBASE_SERVICE_ACCOUNT=

# Orígenes web permitidos por CORS, separados por coma. La app móvil no lo necesita: déjalo vacío.
CORS_ORIGINS=

# (Opcional) Solicitudes por minuto y por usuario antes de responder 429. Por defecto 120.
RATE_LIMIT_PER_MINUTE=

# (Opcional) Catálogo por ISBN. Contacto que se envía a Open Library en el User-Agent (su política lo pide).
OPENLIBRARY_CONTACT=
# (Opcional) Respaldo de Google Books para los ISBN que Open Library no conoce. Clave de la API restringida a
# «Books API». Sin ella solo se consulta Open Library. Es un secreto del servidor.
GOOGLE_BOOKS_API_KEY=
