# Copiar a .env (no commitear .env) y completar con los valores del proyecto de Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional: contacto que se envía a Open Library en el User-Agent (su política pide identificar la app).
# Sin él se envía solo «Lectoria»; con él se identifica y obtiene 3 peticiones por segundo en lugar de 1.
# Atención: se incluye en cada petición y viaja dentro de la app; usa una dirección que no te importe publicar.
EXPO_PUBLIC_OPENLIBRARY_CONTACT=

# Opcional: respaldo de Google Books para los ISBN que Open Library no conoce. Clave de la API (Google Cloud > Credenciales),
# restringida a «Books API» y a la app Android; sin ella solo se consulta Open Library. Viaja dentro de la app.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=
# Huella SHA-1 del certificado con que se firma la app (la misma de la clave de Android de Firebase). Con una clave
# restringida a Android, la petición debe llevar el paquete y esta huella; sin ella no se envían y Google rechaza la clave.
EXPO_PUBLIC_ANDROID_CERT_SHA1=

# Acceso con Google: ID de cliente OAuth de tipo "Web" (Firebase > Authentication > Método de acceso > Google >
# "Configuración del SDK web" > ID de cliente web).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
