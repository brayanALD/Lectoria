# Copiar a .env (no commitear .env) y completar con los valores del proyecto de Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional: contacto que se envía a Open Library en el User-Agent (su política pide identificar la app).
# Sin él se envía solo «Lectoria»; con él se identifica y obtiene 3 peticiones por segundo en lugar de 1.
# Atención: se incluye en cada petición y viaja dentro de la app; usa una dirección que no te importe publicar.
EXPO_PUBLIC_OPENLIBRARY_CONTACT=

# Acceso con Google: ID de cliente OAuth de tipo "Web" (Firebase > Authentication > Método de acceso > Google >
# "Configuración del SDK web" > ID de cliente web).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
