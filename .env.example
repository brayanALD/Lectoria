# Copiar a .env (no commitear .env) y completar con los valores del proyecto de Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Dirección pública de la API de Lectoria (Render). La app escribe y busca por ISBN a través de ella. Ver api/README.md.
# Las claves del catálogo de libros (Open Library, Google Books) ya NO van en la app: son variables de la API (api/.env.example).
EXPO_PUBLIC_API_URL=
# En la web desplegada (Vercel) se deja SIN definir: las llamadas a /v1 pasan por un rewrite de vercel.json hacia la API.

# Acceso con Google: ID de cliente OAuth de tipo "Web" (Firebase > Authentication > Método de acceso > Google >
# "Configuración del SDK web" > ID de cliente web).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Solo desarrollo web (opcional): con esta variable la web habla con los emuladores de Firebase (Auth 9099, Firestore 8080)
# en lugar de producción. En el despliegue de Vercel no se define.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
